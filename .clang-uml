# .clang-uml
compilation_database_dir: out/build/x64-Debug
output_directory: diagrams

diagrams:
  battleship_class_diagram:
    type: class
    glob:
      - src/*.cpp
      - src/*.h
      - src/*.hpp
      - include/*.h
      - include/*.hpp
    include:
      paths:
        - src
    exclude:
      paths:
        - out/build/x64-Debug/_deps
      namespaces:
        - std
        - sf